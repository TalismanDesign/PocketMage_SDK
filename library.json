{
    "name": "pocketmagesdk",
    "version": "1.0.0",
    "description": "The official SDK for developing and publishing PocketMage internal, external, and Wrench apps.",
    "keywords": [
        "PocketMage",
        "assets",
        "library"
    ],
    "authors": [
        {
            "name": "Ashtf",
            "email": "ashtf.contact@gmail.com"
        },
        {
            "name": "NellowTCS",
            "email": "nellowtcs@gmail.com"
        },
        {
            "name": "SagarsGithub",
            "email": "sagarrafai31@gmail.com"
        }
    ],
    "license": "Apache-2.0",
    "homepage": "https://pocketmage.org/",
    "repository": {
        "type": "git",
        "url": "https://github.com/TalismanDesign/PocketMage_SDK"
    },
    "frameworks": [
        "arduino"
    ],
    "platforms": [
        "espressif32"
    ],
    "dependencies": {
        "olikraus/U8g2": "^2.36.4",
        "adafruit/Adafruit BusIO": "^1.17.4",
        "adafruit/RTClib": "^2.1.4",
        "adafruit/Adafruit GFX Library": "^1.12.0",
        "adafruit/Adafruit MPR121": "^1.1.3",
        "adafruit/Adafruit TCA8418": "^1.0.2",
        "gmarty2000/Buzzer": "^1.0.0",
        "TalismanDesign/U8g2_for_Adafruit_GFX": "https://github.com/TalismanDesign/U8g2_for_Adafruit_GFX.git",
        "ashtf8/GxEPD2_Editable_useFastFullUpdate": "https://github.com/ashtf8/GxEPD2_Editable_useFastFullUpdate",
        "TalismanDesign/MP2722_Arduino": "https://github.com/TalismanDesign/MP2722_Arduino.git#idf-v5",
        "esp32beans/ESP32_USB_Host_HID": "https://github.com/esp32beans/ESP32_USB_Host_HID.git"
    },
    "build": {
        "includeDir": ".",
        "srcDir": ".",
        "srcFilter": [
            "+<**>",
            "-<examples/>",
            "-<tools/>",
            "-<docs/>"
        ]
    }
}
